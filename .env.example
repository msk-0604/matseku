# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon キー（または publishable キー sb_publishable_...）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー（または secret キー sb_secret_...）。サーバーとスクリプト専用。絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# LINEのトークン類の暗号化キー（openssl rand -base64 32 で作る）。後から変えると保存済みトークンが読めなくなる
APP_ENCRYPTION_KEY=

# 任意：独自ドメインなどで公開URLを固定したい場合（例：https://repaircall.example.com）
# 未設定なら、アクセスしているURLを使う
APP_URL=

# 毎朝のリペア案内（Vercel Cron）を呼ぶための合言葉。openssl rand -hex 32 で作る
CRON_SECRET=

# Stripe（テスト中は sk_test_...）。WEBHOOK_SECRET は npm run stripe:setup -- <公開URL> で表示される whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# メール送信（Resend）。未設定ならメールは送らずログに出すだけ
RESEND_API_KEY=
# 送信元。ドメイン認証前は onboarding@resend.dev（自分のアドレスにしか届かない）
EMAIL_FROM=リペアコール <onboarding@resend.dev>

# 運営者への日次レポートの送り先
ADMIN_REPORT_EMAIL=

# テスト用データ（npm run seed）で作るログインユーザー
SEED_EMAIL=demo@example.com
SEED_PASSWORD=
